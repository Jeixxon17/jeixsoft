# Configuración web de Firebase (Consola > Configuración del proyecto > Tus apps).
# Estos valores son públicos por diseño; la seguridad la dan Firebase Auth y las reglas.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Administrador (Firebase Console > Authentication > Usuarios). El PIN es la contraseña de ese usuario
# y no se guarda aquí. Debe ser el mismo UID que aparece en firestore.rules.
PUBLIC_ADMIN_EMAIL=
PUBLIC_ADMIN_UID=
